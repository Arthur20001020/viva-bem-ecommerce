    if (!categories[a.category]) categories[a.category] = 0;
    categories[a.category] += a.score;
  });
  
  // Salvar categoria principal
  const mainCategory = Object.keys(categories).reduce((a, b) => 
    categories[a] > categories[b] ? a : b
  );
