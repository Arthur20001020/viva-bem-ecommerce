let currentQuestion = 0;
let answers = [];

function initQuiz() {
  currentQuestion = 0;
  answers = [];
  displayQuestion();
}

function displayQuestion() {
  const quizContent = document.getElementById('quiz-content');
  const quizButtons = document.getElementById('quiz-buttons');
  
  if (currentQuestion < quizData.length) {
    const question = quizData[currentQuestion];
    const progress = ((currentQuestion + 1) / quizData.length) * 100;
    
    // Barra de progresso
    document.querySelector('.quiz-progress-bar').style.width = progress + '%';
    
    // Pergunta
    let html = `
      <div class="quiz-question">
        <h3>${question.question}</h3>
        <div class="quiz-options">
    `;
    
    question.options.forEach((option, index) => {
      html += `
        <label class="quiz-option" onclick="selectOption(${index})">
          <input type="radio" name="answer" value="${index}">
          <span>${option.text}</span>
        </label>
      `;
    });
    
    html += `</div></div>`;
    quizContent.innerHTML = html;
    
    // Botões
    let buttonsHtml = '';
    if (currentQuestion > 0) {
      buttonsHtml += '<button class="btn btn-outline" onclick="previousQuestion()">Voltar</button>';
    }
    buttonsHtml += '<button class="btn btn-primary" onclick="nextQuestion()" id="next-btn">Próximo</button>';
    
    quizButtons.innerHTML = buttonsHtml;
    quizButtons.style.display = 'flex';
  } else {
    showResult();
  }
}

function selectOption(index) {
  const options = document.querySelectorAll('.quiz-option');
  options.forEach(opt => opt.classList.remove('selected'));
  options[index].classList.add('selected');
}

function nextQuestion() {
  const selected = document.querySelector('.quiz-option.selected');
  
  if (!selected) {
    showToast('Por favor, selecione uma opção');
    return;
  }
  
  const index = Array.from(document.querySelectorAll('.quiz-option')).indexOf(selected);
  const option = quizData[currentQuestion].options[index];
  
  answers.push({
    question: quizData[currentQuestion].id,
    answer: option.text,
    score: option.score,
    category: option.category
  });
  
  currentQuestion++;
  displayQuestion();
}

function previousQuestion() {
  if (currentQuestion > 0) {
    currentQuestion--;
    answers.pop();
    displayQuestion();
  }
}

function showResult() {
  const resultModal = document.getElementById('result-modal');
  
  // Calcular resultado
  const totalScore = answers.reduce((sum, a) => sum + a.score, 0);
